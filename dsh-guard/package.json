{
    "name": "dsh-guard",
    "version": "0.1.0",
    "description": "本机安全网：每个 step 前自动给改动文件留检查点（可一键回滚）、按 guard-hooks.json 自动跑校验钩子、把工具调用记进审计日志。",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-tool-suite.git",
        "directory": "dsh-guard"
    },
    "homepage": "https://github.com/Ln1m/dsh-tool-suite/tree/main/dsh-guard#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-tool-suite/issues"
    }
}
