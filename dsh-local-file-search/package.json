{
    "name": "dsh-local-file-search",
    "version": "0.1.2",
    "description": "本机文件搜索（DSH 插件）：在对话框 @ 列表里增加「搜索本机文件」入口，全机一次性搜索，结果不进文件栏/工作区索引",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-input-trigger"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1"
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "license": "MIT",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "plugin",
        "file-search",
        "@mention"
    ],
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-tool-suite.git",
        "directory": "dsh-local-file-search"
    },
    "homepage": "https://github.com/Ln1m/dsh-tool-suite/tree/main/dsh-local-file-search#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-tool-suite/issues"
    }
}
